# Cocoa backend — local environment variables template.
#
# Copy this file to `.env` and fill in real values before running
# `uv run uvicorn app.main:app` against a live database.
#
# IMPORTANT — 2026-07-28 operational rule:
# `cocoa_dev` is the SHARED dev database on local-pgvector (port 5432).
# Do NOT delete or recreate it; other local services depend on it
# (browser_pilot, new-api, nodeskclaw, ...).
# For ad-hoc tests, use `cocoa_test_<uuid>` database names.
# The K8s deployment (scripts/deploy-to-orbstack.sh) uses its own
# separate postgres pod with its own isolated `cocoa_dev` database.
# See .omo/evidence/orbstack-operations.md for details.

# PostgreSQL connection string (asyncpg driver).
# Example: postgresql+asyncpg://cocoa:cocoa@localhost:5432/cocoa
DATABASE_URL=

# JWT signing secret. Replace with a long random value in production.
JWT_SECRET=

# 32-byte base64 key for AES encryption of secrets-at-rest.
# Example:  python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# Root of the Host shared-mount tree for the Fornix mount mirror (v4.5 H3).
# The backend dual-writes FornixFile content into <FORNIX_ROOT>/<workspace_id>/shared/,
# which instance pods mount at /data/shared. Defaults to /var/cocoa/workspaces.
# FORNIX_ROOT=/var/cocoa/workspaces
