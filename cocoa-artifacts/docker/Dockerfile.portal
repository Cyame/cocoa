# syntax=docker/dockerfile:1.7
# Cocoa Portal Static Image — built with npmmirror (China) + served by nginx:alpine.
#
# Multi-stage build: a node:22-alpine builder runs `bun install --frozen-lockfile`
# and `bun run build` to produce the React SPA, then nginx:alpine serves the
# resulting `dist/` directory on port 5173 with SPA fallback to /index.html.
#
# Build context must be the repository root so `cocoa-portal/...` paths resolve.
# Build: docker build -t cocoa-portal:latest -f cocoa-artifacts/docker/Dockerfile.portal .
# Pinned base image (Node 22 LTS — per user direction 2026-07-28).
# Pull: docker pull node:22.11.0-alpine
FROM node:22.11.0-alpine AS builder
WORKDIR /build

# npmmirror (China) for both npm and bun — bun reads npm-style registry config.
RUN npm config set registry https://registry.npmmirror.com && \
    bun config set registry https://registry.npmmirror.com

# Install dependencies first to maximise layer caching.
COPY cocoa-portal/package.json cocoa-portal/bun.lock* ./
RUN bun install --frozen-lockfile

# Copy the rest of the portal and build.
COPY cocoa-portal ./
RUN bun run build

# Pinned runtime base image (nginx 1.27 LTS).
# Pull: docker pull nginx:1.27.4-alpine
FROM nginx:1.27.4-alpine
WORKDIR /usr/share/nginx/html

# Replace the default nginx site with a minimal SPA + healthz config on port 5173.
RUN cat > /etc/nginx/conf.d/default.conf <<'EOF'
server {
    listen 5173;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /healthz {
        default_type text/plain;
        return 200 "ok";
    }
}
EOF

# Serve the built SPA.
COPY --from=builder /build/dist ./

EXPOSE 5173
CMD ["nginx", "-g", "daemon off;"]