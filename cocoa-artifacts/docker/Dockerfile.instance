# syntax=docker/dockerfile:1.7
# Cocoa Instance Host image — Node Host + pinned pi CLI (PRD-v3.5 Tunnel).
#
# Build from repo root:
#   docker build -t cocoa-instance:latest -f cocoa-artifacts/docker/Dockerfile.instance .
#
# Pod main process: cocoa-instance-host (Tunnel WS client + pi --mode rpc).

FROM node:24-bookworm-slim AS host-builder
WORKDIR /build

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/*.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list

COPY cocoa-instance-host/package.json cocoa-instance-host/package-lock.json* ./
COPY cocoa-instance-host/tsconfig.json ./
COPY cocoa-instance-host/src ./src

RUN npm config set registry https://registry.npmmirror.com && \
    npm install && \
    npm run build && \
    npm prune --omit=dev && \
    test -x node_modules/.bin/pi || test -f node_modules/@earendil-works/pi-coding-agent/dist/cli.js

FROM node:24-bookworm-slim
WORKDIR /app

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/*.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list

COPY --from=host-builder /build/dist ./dist
COPY --from=host-builder /build/node_modules ./node_modules
COPY --from=host-builder /build/package.json ./package.json

ENV COCOA_POD_MODE=true
ENV COCOA_WORKSPACE_PATH=/data
ENV COCOA_HOST_PORT=8080
ENV NODE_ENV=production
# Prefer package-local pi binary from @earendil-works/pi-coding-agent@0.83.0
ENV PI_BIN=/app/node_modules/.bin/pi
ENV PATH="/app/node_modules/.bin:${PATH}"

EXPOSE 8080
CMD ["node", "dist/main.js"]
