# syntax=docker/dockerfile:1.7
# Eyot Instance Ancestor image — thin layer over eyot-instance-base with the
# ancestor's enabled subagent agent .md files baked into ~/.pi/agent/agents/.
#
# Part of the v5.1 "1+5" instance image family (see .omo/plans/v5-1-definition.md N2).
# The enabled set per slug is the single source of truth in
# eyot-backend/app/core/builtin_presets.py (manifest.subagent_strategy.enabled);
# scripts/build-instance-images.sh resolves it and passes it via ENABLED_AGENTS
# (space-separated capability ids). SYSTEM.md/AGENTS.md still come from the
# per-instance ConfigMap (G7).
#
# Build from repo root (example):
#   docker build -f eyot-artifacts/docker/Dockerfile.instance-ancestor \
#     --build-arg ENGINE_V=0.83.0 --build-arg SLUG=fox \
#     --build-arg ENABLED_AGENTS="intent architecture research" \
#     -t eyot-instance-fox:0.83.0 .
#
# Pod main process: eyot-instance-host (Tunnel WS client + pi --mode rpc).

ARG ENGINE_V=0.83.0
FROM eyot-instance-base:${ENGINE_V}

ARG SLUG
ARG ENABLED_AGENTS

LABEL org.eyot.instance.ancestor="${SLUG}"
LABEL org.eyot.instance.enabled-agents="${ENABLED_AGENTS}"

# Bake ONLY the enabled agent .md files (thin layer). cp fails the build if an
# enabled capability id has no matching agent file.
COPY eyot-instance-host/subagents/agents/ /tmp/subagent-agents/
RUN test -n "${SLUG}" && \
    test -n "${ENABLED_AGENTS}" && \
    mkdir -p ${HOME}/.pi/agent/agents && \
    for name in ${ENABLED_AGENTS}; do \
      cp "/tmp/subagent-agents/${name}.md" "${HOME}/.pi/agent/agents/"; \
    done && \
    rm -rf /tmp/subagent-agents
